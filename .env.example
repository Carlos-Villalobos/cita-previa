# Copiar como .env (solo una vez) y completar. Nunca se sube a git.

# Bot de Telegram PROPIO de este agente (@BotFather -> /newbot). Envíale /start antes de usarlo:
# por él te pide el código SMS al reservar, así que ningún otro proceso debe leer sus mensajes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Solo si usas Cl@ve (con_clave: true): contraseña del certificado data/certificado.p12
CITA_CERT_PASSWORD=
